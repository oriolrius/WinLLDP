# WinLLDP configuration — copy to .env next to winlldp.exe and adjust.
# Environment variables override these values.

# Seconds between announcements (service). Minimum 5.
LLDP_INTERVAL=30

# Seconds neighbors keep this host (TTL TLV). At least LLDP_INTERVAL, at most 65535.
LLDP_TTL=120

# "all" active interfaces, or one interface name as shown by `winlldp show-interfaces`.
LLDP_INTERFACE=all

# System Name TLV: "auto" uses the computer's host name.
LLDP_SYSTEM_NAME=auto

# Port Description TLV (empty: the interface name).
LLDP_PORT_DESCRIPTION=Ethernet Port

# Management Address TLV: "auto" (the interface's first IPv4 address), or an IPv4/IPv6 address.
LLDP_MANAGEMENT_ADDRESS=auto

# Neighbor table: an absolute path, otherwise neighbors.json next to winlldp.exe.
LLDP_NEIGHBORS_FILE=neighbors.json
